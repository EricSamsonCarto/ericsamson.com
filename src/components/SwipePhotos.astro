---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CONTENT_IMAGE_MAX_WIDTH, CONTENT_IMAGE_SIZES, CONTENT_IMAGE_WIDTHS, PHOTO_IMAGE_QUALITY } from '../lib/content-images';

type Photo = {
  src: ImageMetadata;
  alt: string;
};

type Props = {
  photos: readonly Photo[];
  label: string;
};

const { photos, label } = Astro.props;
---

<div class="mb-6" data-swipe-photos>
  <div class="relative">
    <div
      class="swipe-track flex overflow-x-auto snap-x snap-mandatory rounded-lg shadow-lg"
      tabindex="0"
      role="region"
      aria-label={label}
      data-swipe-track
    >
      {photos.map((photo, index) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          width={CONTENT_IMAGE_MAX_WIDTH}
          widths={CONTENT_IMAGE_WIDTHS}
          sizes={CONTENT_IMAGE_SIZES}
          class="w-full shrink-0 snap-center aspect-[4/3] object-cover"
          quality={PHOTO_IMAGE_QUALITY}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
      ))}
    </div>

    <button
      type="button"
      class="swipe-arrow left-3"
      aria-label="Previous photo"
      hidden
      data-swipe-prev
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      type="button"
      class="swipe-arrow right-3"
      aria-label="Next photo"
      data-swipe-next
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<style>
  .swipe-track {
    scrollbar-width: none;
  }

  .swipe-track::-webkit-scrollbar {
    display: none;
  }

  .swipe-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    color: white;
    background: rgb(0 0 0 / 0.45);
    transition: background-color 150ms;
  }

  .swipe-arrow:hover {
    background: rgb(0 0 0 / 0.7);
  }

  .swipe-arrow[hidden] {
    display: none;
  }
</style>

<script>
  import { initializeSwipePhotos } from '../lib/swipe-photos';
  initializeSwipePhotos();
</script>
