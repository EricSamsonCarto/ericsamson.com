---
import type { CollectionEntry } from 'astro:content';
import BookDetails from './BookDetails.astro';

type Props = {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
---

<dialog
  id={book.id}
  autofocus
  class="book-dialog focus:outline-none m-auto w-[calc(100%-2rem)] max-w-2xl rounded-lg p-0 bg-white dark:bg-neutral-800 text-gray-700 dark:text-white shadow-xl backdrop:bg-black/60"
  aria-label={book.data.title}
>
  <div class="px-4 pt-2 pb-4 md:px-6 md:pt-3 md:pb-6">
    <form method="dialog" class="flex justify-end -mr-1">
      <button
        class="text-2xl leading-none text-gray-500 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
        aria-label="Close"
      >
        ×
      </button>
    </form>
    <BookDetails book={book} />
  </div>
</dialog>
