---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CARD_IMAGE_MAX_WIDTH, CARD_IMAGE_SIZES, CARD_IMAGE_WIDTHS } from '../lib/content-images';

type CardSize = 'small' | 'large';

type Props = {
  title: string;
  date: Date;
  slug: string;
  thumbnail?: ImageMetadata;
  collection: 'projects' | 'tech' | 'books' | 'life';
  eager?: boolean;
  size?: CardSize;
};

const CARD_STYLES: Record<CardSize, { height: string; gradient: string; date: string; title: string }> = {
  small: {
    height: 'h-28 sm:h-32 md:h-36',
    gradient: 'from-black/90 via-black/60',
    date: 'text-[10px] md:text-xs',
    title: 'text-xs md:text-sm',
  },
  large: {
    height: 'h-32 sm:h-40 md:h-48',
    gradient: 'from-black/70 via-black/40',
    date: 'text-xs',
    title: 'text-sm',
  },
};

const { title, date, slug, thumbnail, collection, eager = false, size = 'small' } = Astro.props;

const getUrl = () => {
  if (collection === 'projects') return `/projects/${slug}`;
  if (collection === 'books') return `/writing/books#${slug}`;
  return `/writing/${collection}/${slug}`;
};

const url = getUrl();
const styles = CARD_STYLES[size];
---

<article class="group relative overflow-hidden rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200">
  <a href={url} class="block relative">
    {thumbnail && (
      <div class:list={['relative overflow-hidden', styles.height]}>
        <Image
          src={thumbnail}
          alt={title}
          width={CARD_IMAGE_MAX_WIDTH}
          widths={CARD_IMAGE_WIDTHS}
          sizes={CARD_IMAGE_SIZES}
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
          loading={eager ? "eager" : "lazy"}
        />
        <div class:list={['absolute inset-0 bg-gradient-to-t to-transparent', styles.gradient]}></div>

        <div class="absolute bottom-0 left-0 right-0 p-3 text-white">
          <time class:list={['text-white/90 block mb-1', styles.date]}>
            {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
          </time>
          <p class:list={['font-semibold leading-tight line-clamp-2', styles.title]}>
            {title}
          </p>
        </div>
      </div>
    )}
  </a>
</article>
