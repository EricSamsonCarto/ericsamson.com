---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CARD_IMAGE_MAX_WIDTH, CARD_IMAGE_SIZES, CARD_IMAGE_WIDTHS } from '../lib/content-images';

type Props = {
  title: string;
  date: Date;
  slug: string;
  thumbnail?: ImageMetadata;
  collection: 'projects' | 'tech' | 'books' | 'life';
  eager?: boolean;
};

const { title, date, slug, thumbnail, collection, eager = false } = Astro.props;

const getUrl = () => {
  if (collection === 'projects') return `/projects/${slug}`;
  if (collection === 'books') return `/writing/books#${slug}`;
  return `/writing/${collection}/${slug}`;
};

const url = getUrl();
---

<article class="group relative overflow-hidden rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200">
  <a href={url} class="block relative">
    {thumbnail && (
      <div class="relative h-28 sm:h-32 md:h-36 overflow-hidden">
        <Image
          src={thumbnail}
          alt={title}
          width={CARD_IMAGE_MAX_WIDTH}
          widths={CARD_IMAGE_WIDTHS}
          sizes={CARD_IMAGE_SIZES}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
          loading={eager ? "eager" : "lazy"}
        />
        <!-- Gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent"></div>

        <!-- Text overlay -->
        <div class="absolute bottom-0 left-0 right-0 p-3 text-white">
          <time class="text-[10px] md:text-xs text-white/90 block mb-1">
            {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
          </time>
          <p class="text-xs md:text-sm font-semibold leading-tight line-clamp-2">
            {title}
          </p>
        </div>
      </div>
    )}
  </a>
</article>
